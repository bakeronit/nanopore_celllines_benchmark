        set -eu
        conda activate nanosim
        set +eu

        simulator.py genome \
            --ref_g {input.ref} \
            --model_prefix {params.prefix} \
            --fastq --seed 36 \
            --output simulated/COLO829_BL.{wildcards.depth}x \
            --coverage {wildcards.depth} \
            --num_threads {threads}
        """

