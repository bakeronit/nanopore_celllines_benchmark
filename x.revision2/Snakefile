        expand("simulated/snvs/clairS/COLO829_20.{depth_t}x.COLO829_BL.{depth_n}x/output.vcf.gz", depth_combination, depth_t=["15","30","45","60"], depth_n=["15","30","45","60"]),
        expand("simulated/snvs/clairS/COLO829_10.{depth_t}x.COLO829_BL.{depth_n}x/output.vcf.gz", depth_combination, depth_t=["15","30","45","60"], depth_n=["15","30","45","60"]),
        expand("simulated/snvs/deepsomatic/COLO829_100.{depth_t}x.COLO829_BL.{depth_n}x/output.vcf.gz",depth_combination, depth_t=["15","30","45","60"], depth_n=["15","30","45","60"]),
        expand("simulated/snvs/deepsomatic/COLO829_80.{depth_t}x.COLO829_BL.{depth_n}x/output.vcf.gz",depth_combination, depth_t=["15","30","45","60"], depth_n=["15","30","45","60"]),
        expand("simulated/snvs/deepsomatic/COLO829_60.{depth_t}x.COLO829_BL.{depth_n}x/output.vcf.gz",depth_combination, depth_t=["15","30","45","60"], depth_n=["15","30","45","60"]),
        expand("simulated/snvs/deepsomatic/COLO829_40.{depth_t}x.COLO829_BL.{depth_n}x/output.vcf.gz",depth_combination, depth_t=["15","30","45","60"], depth_n=["15","30","45","60"]),
        expand("simulated/snvs/deepsomatic/COLO829_20.{depth_t}x.COLO829_BL.{depth_n}x/output.vcf.gz",depth_combination, depth_t=["15","30","45","60"], depth_n=["15","30","45","60"]),
        expand("simulated/snvs/deepsomatic/COLO829_10.{depth_t}x.COLO829_BL.{depth_n}x/output.vcf.gz",depth_combination, depth_t=["15","30","45","60"], depth_n=["15","30","45","60"])

wildcard_constraints:
    depth = "[0-9]+",
    depth_t = "[0-9]+",
    depth_n = "[0-9]+",
    purity = "100|80|60|40|20|10",
    sim_purity = "80|60|40|20|10",
    sample = "COLO829_BL|COLO829_100"

rule subsample_bam:
    input:
        bam = "../1.dna_mixing_celllines/work/analysis/bam/R10/sup/COLO829_BL.bam",
        bai = "../1.dna_mixing_celllines/work/analysis/bam/R10/sup/COLO829_BL.bam.bai"
    output:
        bam = "data/COLO829_BL.bam",
        bai = "data/COLO829_BL.bam.bai"
    envmodules:
        "samtools/1.20"
    threads: 8
    resources:
        mem=1,
        walltime=1
    shell:
        """
        samtools view -s 0.01 --subsample-seed 36 -@{threads} -b {input.bam} > {output.bam}
        samtools index {output.bam}
        """

rule add_cstag:
    input:
        "data/COLO829_BL.bam"
    output:
        "data/COLO829_BL.cstag.bam"
    envmodules:
        "conda-envs/base",
        "samtools/1.20"
    threads: 1
    resources:
        mem=24,
        walltime=24
    shell:
        """
        set -eu
        conda activate nanosim
        set +eu

        cstag append {input} | samtools view -b > {output}
        """

rule bam2fastq:
    input:
        "data/COLO829_BL.cstag.bam"
    output:
        "data/COLO829_BL.cstag.fastq"
    envmodules:
        "samtools/1.20"
    threads: 1
    resources:
        mem=4,
        walltime=1
    shell:
        "samtools fastq {input} > {output}"

rule read_analyser:
    input:
        bam = "data/COLO829_BL.cstag.bam",
        fq = "data/COLO829_BL.cstag.fastq"
    output:
        "data/training_del.hist",
        "data/training_ins.hist",
        "data/training_mis.hist",
        "data/training_primary.bam",
    params:
        prefix = "data/training"
    threads: 32
    resources:
        mem=100,
        walltime=24
    envmodules:
        "conda-envs/base"
    shell:
        """
        set -eu
        conda activate nanosim
        set +eu

        read_analysis.py genome \
        --read {input.fq} \
        --g_alnm {input.bam} \
        --fastq \
        --output {params.prefix} \
        --num_threads {threads}
        """

rule get_reference_genome:
    input:
        "../data/genome/reference.fasta"
    output:
        "genome/chr22.fasta"
    envmodules:
        "samtools/1.20"
    threads: 1
    resources:
        mem=2,
        walltime=1
    shell:
        "samtools faidx {input} chr22 > {output} && samtools faidx {output}"

rule get_germline_genome:
    input:
        fa = "genome/chr22.fasta",
        gs = "../gs/vcfs/colo829_bl/merged_normed_isec_snv.hom100.goldstandard.vcf.gz"
    output:
        vcf = "genome/chr22.germline.vcf",
        tbi = "genome/chr22.germline.vcf.tbi",
        fa = "genome/chr22.germline.fasta"
    threads: 1
    resources:
        mem=6,
        walltime=1
    envmodules:
        "samtools/1.20",
        "bcftools/1.22",
        "htslib/1.22.1"
    shell:
        """
        bcftools view -r chr22 {input.gs} | bgzip > {output.vcf}
        tabix -p vcf {output.vcf}
        cat {input.fa} | bcftools consensus -s - {output.vcf} > {output.fa}
        samtools faidx {output.fa}
        """

