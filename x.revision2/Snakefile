def depth_combination(*args):
    depth_t = args[0]
    depth_n = args[1]
    combs = [[dt, dn] for dt in depth_t for dn in depth_n if int(dt[1]) >= int(dn[1]) and not (int(dt[1]) == 60 and int(dn[1]) == 15)]
    for w in combs:
        yield tuple(w)

rule all:
    input:
        expand("simulated/{sample}.{depth}x_aligned_reads.fastq", depth=["15","30","45","60"], sample=["COLO829_BL","COLO829_100"]),
        expand("simulated/{sample}.{depth}x.bam", depth=["15","30","45","60"], sample=["COLO829_BL","COLO829_100"]),
        expand("simulated/snvs/clairS/COLO829_100.{depth_t}x.COLO829_BL.{depth_n}x/output.vcf.gz", depth_combination, depth_t=["15","30","45","60"], depth_n=["15","30","45","60"]),
        expand("simulated/snvs/clairS/COLO829_80.{depth_t}x.COLO829_BL.{depth_n}x/output.vcf.gz", depth_combination, depth_t=["15","30","45","60"], depth_n=["15","30","45","60"]),
        expand("simulated/snvs/clairS/COLO829_60.{depth_t}x.COLO829_BL.{depth_n}x/output.vcf.gz", depth_combination, depth_t=["15","30","45","60"], depth_n=["15","30","45","60"]),
