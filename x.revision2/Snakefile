rule align_minimap2:
    input:
        fq = "simulated/{sample}.{depth}x_aligned_reads.fastq",
        genome = "genome/chr22.fasta"
    output:
        bam = "simulated/{sample}.{depth}x.bam",
        bai = "simulated/{sample}.{depth}x.bam.bai"
    envmodules:
        "minimap2/2.26",
        "samtools/1.20",
        "chopper/0.9.2"
    threads: 24
    resources:
        mem = 12,
        walltime = 1
    params:
        qs = 10,
        rg = "\"@RG\\tID:{sample}\\tPL:ONT\\tSM:{sample}\""
    shell: 
        """
        chopper -q {params.qs} -i {input.fq} | \
        minimap2 -R {params.rg} \
        -y --MD -ax map-ont -t {threads} {input.genome} - | \
        samtools sort -@8 -O BAM --write-index -o {output.bam}##idx##{output.bai} - 
        """

rule simulate_purity:
    input:
        tumour = "simulated/COLO829_100.{depth}x.bam",
        normal = "simulated/COLO829_BL.{depth}x.bam"
    output:
        bam = "simulated/COLO829_{sim_purity}.{depth}x.bam",
        bai = "simulated/COLO829_{sim_purity}.{depth}x.bam.bai"
    params:
        tumour_frac = lambda wildcards: round(int(wildcards.sim_purity)/100, 2),
        normal_frac = lambda wildcards: round((100 - int(wildcards.sim_purity))/100, 2)
    envmodules:
        "samtools/1.20"
    resources:
        mem=10,
        walltime=2
    threads: 24
    shell:
        """
        samtools merge {output.bam} -@ 20 \
        <( samtools view -b -@ 10 --subsample {params.tumour_frac} --subsample-seed 36 {input.tumour} ) \
        <( samtools view -b -@ 10 --subsample {params.normal_frac} --subsample-seed 36 {input.normal} )
        
        samtools index -@ 20 {output.bam}
        """


ClairS_sif = "clairs_v0.1.7.sif"
rule call_somatic_snv_clairS:
    input:
        genome = "genome/chr22.fasta",
        tumor_bam = "simulated/COLO829_{purity}.{depth_t}x.bam",
        tumor_bai = "simulated/COLO829_{purity}.{depth_t}x.bam.bai",
        normal_bam = "simulated/COLO829_BL.{depth_n}x.bam",
        normal_bai = "simulated/COLO829_BL.{depth_n}x.bam.bai"
    output:
        vcf = "simulated/snvs/clairS/COLO829_{purity}.{depth_t}x.COLO829_BL.{depth_n}x/output.vcf.gz",
        passed_vcf = "simulated/snvs/clairS/COLO829_{purity}.{depth_t}x.COLO829_BL.{depth_n}x/output.passed.vcf.gz"
    params:
        platform = "ont_r10_dorado_sup_5khz",
        outdir = "simulated/snvs/clairS/COLO829_{purity}.{depth_t}x.COLO829_BL.{depth_n}x",
        clair3_model = "../data/clair3_models/r1041_e82_400bps_sup_v430" 
    threads: 24
    envmodules:
        "singularity/3.7.1",
        "bcftools/1.19",
        "htslib/1.19.1"
    resources:
        mem = 24,
        walltime = 12
    shell:
        """
        singularity exec {ClairS_sif} /opt/bin/run_clairs \
            --tumor_bam_fn {input.tumor_bam} \
            --normal_bam_fn {input.normal_bam} \
            --ref_fn {input.genome} \
            --clair3_model_path {params.clair3_model} \
            --include_all_ctgs \
            --sample_name COLO829_{wildcards.purity} \
            --threads {threads} \
            --platform {params.platform} \
            --output_dir {params.outdir} \
            --remove_intermediate_dir \
            --conda_prefix /opt/conda/envs/clairs
        
        bcftools view -f PASS {output.vcf} -o {output.passed_vcf}
        tabix -p vcf {output.passed_vcf}
        """


DP_somatic_sif = deepsomatic_1.6.0.sif"

rule call_somatic_snv_deepsomatic:
    input:
        genome = "genome/chr22.fasta",
        tumor_bam = "simulated/COLO829_{purity}.{depth_t}x.bam",
        tumor_bai = "simulated/COLO829_{purity}.{depth_t}x.bam.bai",
        normal_bam = "simulated/COLO829_BL.{depth_n}x.bam",
        normal_bai = "simulated/COLO829_BL.{depth_n}x.bam.bai"
    output:
        vcf = "simulated/snvs/deepsomatic/COLO829_{purity}.{depth_t}x.COLO829_BL.{depth_n}x/output.vcf.gz",
        somatic_vcf = "simulated/snvs/deepsomatic/COLO829_{purity}.{depth_t}x.COLO829_BL.{depth_n}x/output.passed.vcf.gz"
    params:
        model="../data/dpsomatic_model/weights-143-0.987994.ckpt"
    threads: 48
    envmodules:
        "singularity/3.7.1",
        "bcftools/1.19",
        "htslib/1.19.1"
    resources:
        mem=36,
        walltime=24
    shell:
        """
        singularity exec {DP_somatic_sif} /opt/deepvariant/bin/deepsomatic/run_deepsomatic \
        --ref={input.genome} \
        --model_type=ONT_R104 \
        --reads_normal={input.normal_bam} \
        --reads_tumor={input.tumor_bam} \
        --output_vcf={output.vcf} \
        --sample_name_tumor="COLO829_{wildcards.purity}" \
        --sample_name_normal="COLO829_BL" \
        --num_shards={threads} \
        --customized_model={params.model}

        bcftools filter -i 'GT="1/1"' {output.vcf} |bgzip > {output.somatic_vcf}
        tabix -p vcf {output.somatic_vcf}
        """

